{
    "name": "leenuxus/jarenui",
    "description": "A Jaren-UI compatible Livewire component library for Laravel — 50+ components, dark mode, CSS-variable theming.",
    "keywords": ["laravel", "livewire", "ui", "components", "blade", "alpine", "tailwind", "dark-mode"],
    "homepage": "https://github.com/leenuxus/jarenui",
    "license": "MIT",
    "type": "library",

    "authors": [
        {
            "name": "jarenui",
            "email": "leenuxus@gmail.com",
            "homepage": "https://jarenui.dev"
        }
    ],

    "require": {
        "php":                    "^8.4",
        "illuminate/support":     "^13.0",
        "illuminate/view":        "^13.0",
        "livewire/livewire":      "^4.0"
    },

    "require-dev": {
        "orchestra/testbench":    "^11.0",
        "pestphp/pest":           "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint":           "^1.0"
    },

    "autoload": {
        "psr-4": {
            "JarenUI\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "JarenUI\\Tests\\": "tests/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "JarenUI\\JarenUIServiceProvider"
            ],
            "aliases": {
                "JarenUI": "JarenUI\\Facades\\JarenUI"
            }
        }
    },

    "scripts": {
        "test":   "vendor/bin/pest",
        "lint":   "vendor/bin/pint",
        "format": "vendor/bin/pint"
    },

    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}
